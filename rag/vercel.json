{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{testes/**,avaliacao/**,dados/texto/**,dados/curados/**,dados/originais/**,dados/brutos/**,dados/chroma*/**}"
    }
  }
}

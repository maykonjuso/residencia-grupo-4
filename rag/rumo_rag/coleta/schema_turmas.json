{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oferta de turmas de graduação da FCTE (SIGAA, consulta pública) · issue #56",
  "type": "object",
  "required": ["versao_schema", "fonte", "ano_periodo", "turmas"],
  "additionalProperties": false,
  "properties": {
    "versao_schema": {"const": "1.0"},
    "ano_periodo": {"type": "string", "pattern": "^\\d{4}\\.[1-4]$"},
    "fonte": {
      "type": "object",
      "required": ["orgao", "url", "consulta", "coletado_em"],
      "properties": {
        "orgao": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"},
        "consulta": {"type": "object"},
        "coletado_em": {"type": "string", "format": "date"},
        "observacao": {"type": "string"}
      }
    },
    "turmas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigo", "nome", "turma", "ano_periodo", "horario_sigaa", "aulas", "local", "salas"],
        "additionalProperties": false,
        "properties": {
          "codigo": {"type": "string", "pattern": "^[A-Z]{3,4}\\d{4}$"},
          "nome": {"type": "string", "minLength": 1},
          "id_componente": {"type": ["string", "null"]},
          "turma": {"type": "string", "minLength": 1},
          "ano_periodo": {"type": "string"},
          "horario_sigaa": {"type": ["string", "null"]},
          "aulas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["dia", "inicio", "fim"],
              "additionalProperties": false,
              "properties": {
                "dia": {"enum": ["segunda", "terça", "quarta", "quinta", "sexta", "sábado", "domingo"]},
                "inicio": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
                "fim": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"}
              }
            }
          },
          "periodo_letivo": {
            "type": ["object", "null"],
            "required": ["inicio", "fim"],
            "properties": {
              "inicio": {"type": "string", "format": "date"},
              "fim": {"type": "string", "format": "date"}
            }
          },
          "local": {"type": ["string", "null"]},
          "salas": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

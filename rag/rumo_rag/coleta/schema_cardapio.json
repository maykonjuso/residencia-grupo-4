{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rumo/cardapio-estruturado.json",
  "title": "Cardápio estruturado por compartimento (monta-prato)",
  "type": "object",
  "required": ["unidade", "data", "refeicao", "compartimentos", "mesa_apoio", "alergenicos", "fonte", "avisos"],
  "additionalProperties": false,
  "properties": {
    "unidade": {"type": "string", "minLength": 1},
    "data": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "refeicao": {"enum": ["cafe", "almoco", "jantar"]},
    "compartimentos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot", "titulo", "max", "opcoes"],
        "additionalProperties": false,
        "properties": {
          "slot": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "titulo": {"type": "string", "minLength": 1},
          "max": {"type": "integer", "minimum": 1},
          "opcoes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "nome", "trilha", "alergenicos", "fonte"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                "nome": {"type": "string", "minLength": 1},
                "trilha": {"enum": ["todas", "padrao", "ovolacto", "vegano"]},
                "alergenicos": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/alergenico"}
                },
                "fonte": {"$ref": "#/$defs/fonte"}
              }
            }
          }
        }
      }
    },
    "mesa_apoio": {"type": "array", "items": {"type": "string"}},
    "alergenicos": {
      "type": "object",
      "required": ["disponivel", "legenda", "observacao"],
      "additionalProperties": false,
      "properties": {
        "disponivel": {"type": "boolean"},
        "legenda": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nome"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/alergenico"},
              "nome": {"type": "string", "minLength": 1}
            }
          }
        },
        "observacao": {"type": "string"}
      }
    },
    "fonte": {
      "allOf": [
        {"$ref": "#/$defs/fonte"},
        {"required": ["url"], "properties": {"url": {"type": "string"}}}
      ]
    },
    "avisos": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "alergenico": {
      "enum": [
        "cogumelo",
        "leite",
        "mel",
        "pimenta",
        "soja",
        "gluten",
        "amendoim",
        "oleaginosa",
        "ovo",
        "suino"
      ]
    },
    "fonte": {
      "type": "object",
      "required": ["doc_id", "pagina"],
      "properties": {
        "doc_id": {"type": "string", "pattern": "^F\\d{2}$"},
        "pagina": {"type": "integer", "minimum": 1},
        "chunk_id": {"type": "string"},
        "url": {"type": "string"}
      }
    }
  }
}

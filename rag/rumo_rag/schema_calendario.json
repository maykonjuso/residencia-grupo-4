{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalendarioAcademicoRUmo",
  "description": "Calendário acadêmico estruturado da UnB extraído do catálogo do RUmo (Issue #57).",
  "type": "object",
  "required": ["versao", "gerado_em", "semestres", "documentos_calendario"],
  "additionalProperties": false,
  "properties": {
    "versao": {"type": "string", "minLength": 1},
    "gerado_em": {"type": "string", "minLength": 10},
    "semestres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "semestre",
          "doc_id",
          "titulo",
          "orgao",
          "url",
          "pagina",
          "vigencia",
          "periodo_letivo",
          "periodo_aulas",
          "feriados",
          "pontos_facultativos",
          "eventos",
          "recesso",
          "semana_provas",
          "observacoes"
        ],
        "additionalProperties": false,
        "properties": {
          "semestre": {"type": "string", "pattern": "^20\\d{2}\\.\\d$"},
          "doc_id": {"type": "string", "minLength": 1},
          "titulo": {"type": "string", "minLength": 1},
          "orgao": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "pagina": {"type": "integer", "minimum": 1},
          "vigencia": {"$ref": "#/$defs/intervaloDatas"},
          "periodo_letivo": {"$ref": "#/$defs/intervaloDatas"},
          "periodo_aulas": {"$ref": "#/$defs/intervaloDatas"},
          "feriados": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["data", "dia_semana", "nome", "abrangencia", "observacao"],
              "additionalProperties": false,
              "properties": {
                "data": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "dia_semana": {"type": "string"},
                "nome": {"type": "string", "minLength": 1},
                "abrangencia": {"type": "string"},
                "observacao": {"type": "string"}
              }
            }
          },
          "pontos_facultativos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["data", "dia_semana", "nome", "horario", "observacao"],
              "additionalProperties": false,
              "properties": {
                "data": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "dia_semana": {"type": "string"},
                "nome": {"type": "string", "minLength": 1},
                "horario": {"type": ["string", "null"]},
                "observacao": {"type": "string"}
              }
            }
          },
          "eventos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["titulo", "data", "inicio", "fim", "observacao"],
              "additionalProperties": false,
              "properties": {
                "titulo": {"type": "string", "minLength": 1},
                "data": {"type": ["string", "null"]},
                "inicio": {"type": ["string", "null"]},
                "fim": {"type": ["string", "null"]},
                "observacao": {"type": "string"}
              }
            }
          },
          "recesso": {
            "type": "array",
            "items": {"$ref": "#/$defs/intervaloNomeado"}
          },
          "semana_provas": {
            "type": "array",
            "items": {"$ref": "#/$defs/intervaloNomeado"}
          },
          "observacoes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "documentos_calendario": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titulo", "orgao", "url", "arquivo", "data", "vigencia"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "titulo": {"type": "string", "minLength": 1},
          "orgao": {"type": "string", "minLength": 1},
          "url": {"type": "string"},
          "arquivo": {"type": "string"},
          "data": {"type": "string"},
          "vigencia": {
            "type": ["object", "null"],
            "required": ["inicio", "fim"],
            "additionalProperties": false,
            "properties": {
              "inicio": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "fim": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "intervaloDatas": {
      "type": "object",
      "required": ["inicio", "fim"],
      "additionalProperties": false,
      "properties": {
        "inicio": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "fim": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "intervaloNomeado": {
      "type": "object",
      "required": ["titulo", "inicio", "fim", "observacao"],
      "additionalProperties": false,
      "properties": {
        "titulo": {"type": "string"},
        "inicio": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "fim": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "observacao": {"type": "string"}
      }
    }
  }
}
